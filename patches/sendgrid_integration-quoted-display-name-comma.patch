+  /**
+   * Splits a comma separated address list into individual addresses.
+   *
+   * Commas inside double quoted display names are kept, so
+   * '"Last, First" <a@example.com>, b@example.com' yields two addresses.
+   *
+   * @param string $addresses
+   *   The address list.
+   *
+   * @return string[]
+   *   The trimmed, non-empty addresses.
+   */
+  protected function splitAddresses(string $addresses): array {
+    $result = [];
+    $current = '';
+    $in_quotes = FALSE;
+    $length = strlen($addresses);
+    for ($i = 0; $i < $length; $i++) {
+      $char = $addresses[$i];
+      if ($char === '\\' && $in_quotes && $i + 1 < $length) {
+        // Keep escaped characters (e.g. \") as part of the display name.
+        $current .= $char . $addresses[++$i];
+        continue;
+      }
+      if ($char === '"') {
+        $in_quotes = !$in_quotes;
+      }
+      elseif ($char === ',' && !$in_quotes) {
+        $result[] = $current;
+        $current = '';
+        continue;
+      }
+      $current .= $char;
+    }
+    $result[] = $current;
+    return array_values(array_filter(array_map('trim', $result), 'strlen'));
   }
 
