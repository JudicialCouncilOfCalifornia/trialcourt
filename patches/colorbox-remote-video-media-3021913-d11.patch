@@ -0,0 +1,20 @@
+/**
+ * @file
+ * The remote video colorbox integration.
+ */
+
+(function ($, Drupal, once) {
+  Drupal.behaviors.videoRemoteColorbox = {
+    attach: function (context, settings) {
+      once('colorbox-remote-video', '.remote-video-colorbox-launch-modal', context).forEach(function (element) {
+        $(element).on('click', function (e) {
+          // Allow the thumbnail that launches the modal to link to other places
+          // such as video URL, so if the modal is sidestepped things degrade
+          // gracefully.
+          e.preventDefault();
+          $.colorbox($.extend(settings.colorbox, {'html': $(this).data('remote-video-colorbox-modal')}));
+        });
+      });
+    }
+  };
+})(jQuery, Drupal, once);
