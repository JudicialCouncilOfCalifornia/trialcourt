  jcc_courts_custom_run_migration($migration_id, TRUE);
}

/**
 * Common migration function.
 */
function jcc_courts_custom_run_migration($migration_id, $sync_option = FALSE) {
  $queue = \Drupal::queue('opinions_sync_queue_worker');
  $queue_worker = \Drupal::service('plugin.manager.queue_worker')->createInstance('opinions_sync_queue_worker');

  // Create queue item.
  $data = [
    'migration_id' => $migration_id,
    'sync_option' => $sync_option,
  ];
  $queue->createItem($data);

  // Queue item managment.
  while ($item = $queue->claimItem()) {
    try {
      $queue_worker->processItem($item->data);
      $queue->deleteItem($item);
    }
    catch (RequeueException $e) {
      // Item will be requeued automatically.
      $queue->releaseItem($item);
    }
    catch (\Exception $e) {
      // Critical failure - remove item and log error.
      \Drupal::logger('jcc_courts_custom')->error('Queue processing failed: @message', [
        '@message' => $e->getMessage(),
      ]);
      $queue->deleteItem($item);
    }
  }
}
