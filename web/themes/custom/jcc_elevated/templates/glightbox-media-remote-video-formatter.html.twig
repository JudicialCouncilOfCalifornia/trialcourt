{#
/**
 * @file
 * Default theme implementation to display a formatted glightbox image field.
 *
 * Available variables:
 * - image: A collection of image data.
 * - url: An URL the image can be linked to.
 * - attributes: Link attributes.
 *
 * @see template_preprocess_glightbox_formatter()
 *
 * @ingroup themeable
 */
#}

{# Our style and behavior customizations. #}
{{ attach_library("jcc_elevated/remote-video") }}

<a {{ attributes }}>
	{{ image }}

	{# Leverage description as link context for screen readers. #}
	{# Not sure why module is hiding with CSS so may need to revisit later. #}
	{% if caption_description is not empty %}
		<div class="glightbox-desc sr-only">
			{{- 'Play video ' ~ caption_description -}}
		</div>
	{% endif %}
</a>

