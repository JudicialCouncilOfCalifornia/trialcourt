<?php

/**
 * @file
 * Installation items for jcc_components_profile profile.
 */

/**
 * TCI-284: Update field formats for existing paragraph content.
 */
function jcc_components_profile_update_8001() {
  $table = 'paragraphs_item';
  $type = 'paragraph';
  $id = 'id';
  $formats = [
    'default' => [
      'field_lead' => 'minimal',
      'field_aside' => 'aside',
      'field_text' => 'body',
    ],
    'action_list_item' => [
      'field_text' => 'minimal',
    ],
    'alert' => [
      'field_text' => 'minimal',
    ],
    'card' => [
      'field_text' => 'minimal',
    ],
    'hero' => [
      'field_aside' => 'minimal',
    ],
  ];

  jcc_components_profile_set_field_format($table, $type, $id, $formats);
}

/**
 * TCI-284: Update field formats for existing node content.
 */
function jcc_components_profile_update_8002() {
  $table = 'node';
  $type = 'node';
  $id = 'nid';
  $formats = [
    'default' => [
      'body' => 'body',
    ],
    'alert' => [
      'body' => 'minimal',
    ],
    'subpage' => [
      'body' => 'full_html',
    ],
  ];

  jcc_components_profile_set_field_format($table, $type, $id, $formats);
}

/**
 * Revoke permissions that no longer exist from every role - D10 upgrade.
 */
function jcc_components_profile_update_10001() {
  $permissions = array_keys(\Drupal::service('user.permissions')->getPermissions());
  /** @var \Drupal\user\RoleInterface[] $roles */
  $roles = \Drupal::entityTypeManager()->getStorage('user_role')->loadMultiple();
  $revoked = [];

  foreach ($roles as $role) {
    $orphans = array_diff($role->getPermissions(), $permissions);
    if (empty($orphans)) {
      continue;
    }

    foreach ($orphans as $permission) {
      $role->revokePermission($permission);
    }
    $role->save();
    $revoked[] = $role->id() . ': ' . implode(', ', $orphans);
  }

  if (empty($revoked)) {
    return 'No orphaned permissions found.';
  }

  return 'Revoked orphaned permissions - ' . implode(' | ', $revoked);
}

/**
 * Install jcc_sendgrid_mail.
 */
function jcc_components_profile_update_10002() {
  \Drupal::service('module_installer')->install(['jcc_sendgrid_mail']);
}

/**
 * Update node type conditions from node_type to entity_bundle.
 */
function jcc_components_profile_update_10003() {
  // Load all pattern configuration entities.
  foreach (\Drupal::configFactory()->listAll('pathauto.pattern.') as $pattern_config_name) {
    $pattern_config = \Drupal::configFactory()->getEditable($pattern_config_name);

    // Loop patterns and swap the node_type plugin by the entity_bundle:node
    // plugin.
    if ($pattern_config->get('type') === 'canonical_entities:node') {
      $selection_criteria = $pattern_config->get('selection_criteria');
      foreach ($selection_criteria as $uuid => $condition) {
        if ($condition['id'] === 'node_type') {
          $pattern_config->set("selection_criteria.$uuid.id", 'entity_bundle:node');
          $pattern_config->save();
          break;
        }
      }
    }
  }
}

/**
 * Set the field formats for existing content.
 *
 * @param string $table
 *   The name of the table to fetch ids.
 * @param string $type
 *   The entity type.
 * @param string $id
 *   The entity type id name. id, nid.
 * @param array $formats
 *   An assoiative array mapping bundle => field => format.
 *   Should include a 'default' bundle and only overrides for each other
 *   bundle as necessary.
 */
function jcc_components_profile_set_field_format($table, $type, $id, array $formats) {
  $query = \Drupal::database()->select($table, 'e');
  $query->fields('e', [$id]);
  $result = $query->execute();

  while ($entity_id = $result->fetchField()) {
    $entity = \Drupal::entityTypeManager()->getStorage($type)->load($entity_id);
    $bundle = $entity->bundle();
    $bundle_formats = array_key_exists($bundle, $formats) ? array_merge($formats['default'], $formats[$bundle]) : $formats['default'];

    foreach ($bundle_formats as $field => $format) {
      if (!empty($entity->$field)) {
        if ($entity->$field->format && $entity->$field->format !== $format) {
          $entity->$field->format = $format;
          $entity->save();
        }
      }
    }
  }
}

/**
 * Makes big_pipe's queued post update resolvable after it is uninstalled.
 */
function jcc_components_profile_update_10004() {
  // Drush builds the list of pending updates once, before anything runs, so on
  // sites that still had big_pipe installed the operation for
  // big_pipe_post_update_html5_placeholders is already queued.
  // pantheon_advanced_page_cache_update_8002() then uninstalls the module, and
  // when that queued operation is reached the registry refuses to load
  // big_pipe.post_update.php for an extension that is no longer installed:
  // UpdateDBCommands::updateDoOnePostUpdate() only looks at function_exists(),
  // so it aborts the whole batch.
  //
  // Loading the file by hand defines the function for the rest of this process,
  // which is all that check cares about. The function is an empty no-op in
  // core, so nothing is skipped by resolving it this way. Doing it here rather
  // than reinstalling the module avoids two module state changes, and with them
  // the locale batches that batch_set() injects into the running update batch.
  if (function_exists('big_pipe_post_update_html5_placeholders')) {
    return 'The big_pipe post update is already loaded.';
  }

  $file = DRUPAL_ROOT . '/core/modules/big_pipe/big_pipe.post_update.php';
  if (!file_exists($file)) {
    return 'big_pipe is not present in this core, nothing to load.';
  }

  include_once $file;

  return 'Loaded big_pipe.post_update.php so its queued post update can resolve.';
}

/**
 * Normalises taxonomy_index_tid filter values that are not arrays.
 */
function jcc_components_profile_update_10005() {
  // TaxonomyIndexTid::calculateDependencies() passes the filter value straight
  // to EntityStorageBase::loadMultiple(), and loadMultiple(NULL) means "load
  // every term", not "load none". On a site with a large vocabulary that is
  // enough to exhaust memory the moment any post update saves the view, and the
  // kernel kills whichever process holds the most memory. A scalar value blows
  // up differently, with a TypeError, since the argument is typed ?array.
  //
  // Config is rewritten raw on purpose: saving the View entity would trigger the
  // very calculateDependencies() call this update exists to make safe.
  $config_factory = \Drupal::configFactory();
  $fixed = [];

  foreach ($config_factory->listAll('views.view.') as $name) {
    $config = $config_factory->getEditable($name);
    $displays = $config->get('display') ?: [];
    $changed = FALSE;

    foreach ($displays as $display_id => $display) {
      foreach ($display['display_options']['filters'] ?? [] as $filter_id => $filter) {
        $plugin_id = $filter['plugin_id'] ?? '';
        if ($plugin_id !== 'taxonomy_index_tid' && $plugin_id !== 'taxonomy_index_tid_depth') {
          continue;
        }

        $value = $filter['value'] ?? NULL;
        if (is_array($value)) {
          continue;
        }

        // A numeric scalar is a single term id that was stored unwrapped;
        // anything else cannot be a term id and becomes an empty list.
        $new_value = is_numeric($value) ? [(int) $value] : [];
        $displays[$display_id]['display_options']['filters'][$filter_id]['value'] = $new_value;
        $changed = TRUE;
        $fixed[] = sprintf('%s:%s:%s (%s)', $name, $display_id, $filter_id, $value === NULL ? 'null' : var_export($value, TRUE));
      }
    }

    if ($changed) {
      $config->set('display', $displays)->save();
    }
  }

  return $fixed
    ? 'Normalised taxonomy filter values: ' . implode('; ', $fixed) . '.'
    : 'No taxonomy_index_tid filters needed normalising.';
}
