        "phpmd/phpmd": "@stable",
        "phpstan/phpstan": "^2.1",
        "rector/rector": "^2.0"
    },
    "replace": {
        "drupal/ckeditor": "*"
    },
    "conflict": {
        "drupal/drupal": "*"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "process-timeout": 600,
        "sort-packages": true,
        "allow-plugins": {
            "composer/installers": true,
            "cweagans/composer-patches": true,
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "drupal/console-extend-plugin": true,
            "drupal/core-composer-scaffold": true,
            "drupal/core-project-message": true,
            "mglaman/composer-drupal-lenient": true,
            "oomphinc/composer-installers-extender": true,
            "php-http/discovery": true,
            "symfony/runtime": true
        }
    },
    "autoload": {
        "classmap": [
            "scripts/composer/ScriptHandler.php"
        ],
        "files": [
            "load.environment.php"
        ]
    },
    "scripts": {
        "pre-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "pre-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::checkComposerVersion"
        ],
        "post-install-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/modules/ -type d -name .git | xargs rm -rf",
            "find ./web/themes/custom/ -type d -name .git | xargs rm -rf",
            "find ./web/profiles/ -type d -name .git | xargs rm -rf",
            "find ./web/libraries/ -type d -name .git | xargs rm -rf"
        ],
        "post-update-cmd": [
            "DrupalProject\\composer\\ScriptHandler::createRequiredFiles",
            "find ./vendor/ -type d -name .git | xargs rm -rf",
            "find ./web/ -type d -name .git | xargs rm -rf",
            "find ./web/modules/ -type d -name .git | xargs rm -rf",
            "find ./web/themes/custom/ -type d -name .git | xargs rm -rf",
            "find ./web/profiles/ -type d -name .git | xargs rm -rf",
            "find ./web/libraries/ -type d -name .git | xargs rm -rf"
        ],
        "build-assets": [
            "@prepare-for-pantheon",
            "composer install --optimize-autoloader --no-dev"
        ],
        "lint": "find web/modules/custom web/themes/custom -name '*.php' -exec php -l {} \\;",
        "code-sniff": "echo 'No code sniff defined yet.'",
        "unit-test": "echo 'No unit test step defined.'",
        "phpstan": "vendor/bin/phpstan analyse",
        "rector": "vendor/bin/rector process --dry-run",
        "artifact-sync": [
            "rsync -KPar --delete --force --exclude='node_modules' --files-from=scripts/deploy.txt ./ data/artifact/"
        ]
    },
    "extra": {
        "composer-exit-on-patch-failure": true,
        "patchLevel": {
            "drupal/core": "-p2"
        },
        "patches": {
            "drupal/core": {
                "Don't override media title with metadata on translation save.": "https://www.drupal.org/files/issues/2019-04-25/media-translation_hassourcefieldchanged-2999370-11.patch",
                "Dynamically provide action plugins for content moderation": "https://www.drupal.org/files/issues/2020-01-25/2797583-149.patch",
                "Content moderation state entity query support": "https://www.drupal.org/files/issues/2020-09-25/3025164-28.patch",
                "Add Mayan and Tigrinya language support": "patches/add-mayan-tigrinya-languages-02.patch",
                "Enable Needs Translation on moderated content.": "patches/core-translation-outdated-moderated-2950626-d11.patch",
                "Fix for unable to decode outout into JSON": "patches/locale_patch.patch",
                "PoStreamReader error": "https://www.drupal.org/files/issues/2023-01-17/drupal_core-PoStreamReader_readLine_throws_an_error_on_module_install-3301239-7.patch",
                "Fix for PHP warning isArray check": "patches/fixphp-warning-d11.patch",
                "Fix for deprecated function mb_strtolower": "https://www.drupal.org/files/issues/2023-11-21/3199.patch",
                "PHP warnings in array_flip": "https://www.drupal.org/files/issues/2023-01-12/3145190-21.patch",
                "Workflow options in views filter": "patches/core-content-moderation-multiple-workflow-filter-3382759-d11.patch",
                "Media library select form TypeError when no items are selected": "patches/core-media-library-select-form-null-selection.patch"
            },
            "drupal/entity_usage": {
                "Remove old rivisions from usage count.": "https://www.drupal.org/files/issues/2020-09-26/entity_usage_views_integration_usage_count-3043388-6.patch"
            },
            "drupal/devel": {
                "Fix devel count() warning in php 7.2": "patches/devel-count-warning.patch",
                "Fix Cannot unset offset in a non-array variable in devel_get_handlers": "patches/devel-unset-issue.patch"
            },
            "drupal/filefield_paths": {
                "#3622262 - Readonly classes are PHP 8.2+; parse error on PHP 8.1": "patches/filefield_paths-php81-readonly-class.patch"
            },
            "drupal/json_feed": {
                "Adds JSONP support to feeds": "patches/json_feed_jsonp_support.patch",
                "Drupal 11 core_version_requirement": "patches/json_feed-d11-compatibility.patch"
            },
            "drupal/linkit_media_library": {
                "Restore the 1.x Media Library button in the CKEditor 4 link dialog": "patches/linkit_media_library-2-ckeditor4-media-library-button.patch"
            },
            "drupal/regex_redirect": {
                "Patched module for proper string comparison": "patches/3172316-captured-value-not.patch",
                "Drupal 11 core_version_requirement": "patches/regex_redirect-d11-compatibility.patch"
            },
            "drupal/migrate_plus": {
                "Convert SimpleXMLElement to array": "https://www.drupal.org/files/issues/2022-05-31/migrate_tools-xml-class-too-3076534-19.patch"
            },
            "drupal/redirect": {
                "Allowing wildcards": "https://git.drupalcode.org/project/redirect/-/merge_requests/97.diff"
            },
            "drupal/media_directories": {
                "Drupal 10 compatibility for MediaDirectoriesImageDimensionsFormatter": "patches/media_directories-d10-image-formatter.patch"
            },
            "drupal/tooltip": {
                "Remove the CKEditor 4 dependency": "patches/tooltip-remove-ckeditor4-dependency.patch"
            },
            "drupal/video_embed_field": {
                "Allow creation of new video media entities using the Media Browser": "https://www.drupal.org/files/issues/2020-06-20/vef-3039873-media-library-add-32.patch"
            },
            "drupal/autocomplete_deluxe": {
                "Allow multiple references with same title": "https://www.drupal.org/files/issues/2019-07-25/3053986_4.patch",
                "undefined-autocomplete-data-key": "https://www.drupal.org/files/issues/2022-06-09/undefined-autocomplete-data-key-3284962-2.patch"
            },
            "drupal/fullcalendar_view": {
                "Fix for Calendar options": "patches/fix-title-apostrophe-render-fullcalendarview.patch"
            },
            "drupal/colorbox": {
                "Add support for remote video media (#3021913 comment 43, with core once() for jQuery 4)": "patches/colorbox-remote-video-media-3021913-d11.patch"
            },
            "drupal/migrate_source_csv": {
                "Importing CSV data by URL based off https://www.drupal.org/files/issues/2021-10-28/csv-from-url-2927126-15.patch": "patches/import_from_csv_url_with_date_replacement.patch"
            },
            "drupal/nodeaccess": {
                "null in nodeaccess_node_access_records() & Undefined array key NodeAccessHelper": "https://www.drupal.org/files/issues/2026-09-09/3419865-04-nodeaccess_node.patch"
            },
            "drupal/scheduler": {
                "Schedule does not work for forward pending revisions after published": "https://www.drupal.org/files/issues/2026-06-18/3080979-76.patch"
            },
            "drupal/events_log_track": {
                "Fix to trucate title to 255 characters": "patches/events_log_track_title_truncate.patch"
            },
            "drupal/search_api": {
                "SQL duplicate entry warnings still occurring after v1.30": "https://www.drupal.org/files/issues/2023-11-23/sqlstate-duplicate-entry-warning-when-theres-a-49-symbols-word-3402938-4.patch"
            },
            "drupal/ga_login": {
                "Drupal 10/11 core_version_requirement": "patches/ga_login-d11-compatibility.patch"
            },
            "drupal/focal_point": {
                "Undefined width/height in FocalPointImageWidget::value() on new media": "patches/focal_point-undefined-width-height-media-library.patch"
            },
            "judicialcouncil/jcc_storybook": {
                "Drupal 11 core_version_requirement (until JCC publishes a D11 release)": "patches/jcc_storybook-d11-compatibility.patch"
            },
            "drupal/ckeditor_templates": {
                "Drupal 11: FileExtension upload validator instead of file_validate_extensions": "patches/ckeditor_templates-d11-file-extension-validator.patch"
            }
        },
        "installer-paths": {
            "web/core": [
                "type:drupal-core"
            ],
            "web/libraries/{$name}": [
                "type:drupal-library",
                "harvesthq/chosen"
            ],
            "web/modules/contrib/{$name}": [
                "type:drupal-module"
            ],
            "web/profiles/contrib/{$name}": [
                "type:drupal-profile"
            ],
            "web/themes/contrib/{$name}": [
                "type:drupal-theme"
            ],
            "drush/Commands/{$name}": [
                "type:drupal-drush"
            ]
        },
        "drupal-scaffold": {
            "locations": {
                "web-root": "web/"
            },
            "file-mapping": {
                "[web-root]/robots.txt": false
            },
            "gitignore": false
        },
        "drupal-lenient": {
            "allowed-list": [
                "drupal/components",
                "drupal/csv_serialization",
                "drupal/migrate_source_csv",
                "drupal/geocoder",
                "drupal/migrate_google_sheets",
                "drupal/openid_connect_windows_aad",
                "drupal/media_directories",
                "drupal/ga_login",
                "drupal/json_feed",
                "drupal/regex_redirect"
            ]
        }
    }
}
